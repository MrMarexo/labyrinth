# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Drizzle
# Neon — use a personal development branch, never the main branch.
# DATABASE_URL: the pooled connection string (PgBouncer, transaction mode).
# Used by the app at runtime — short queries suit pooling well.
DATABASE_URL="postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/labyrinth?sslmode=require"
# DATABASE_URL_UNPOOLED: the direct (unpooled) connection string.
# Used by drizzle-kit for migrations — DDL needs session state to survive
# between statements, which a transaction-mode pooler does not guarantee.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/labyrinth?sslmode=require"

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-32-bytes-of-base64"
# Optional. Production sets this to the real domain. Preview deployments get a
# different hostname on every deploy, so leave it unset there and Better Auth
# will infer the origin from the incoming request.
BETTER_AUTH_URL="http://localhost:3000"
# Optional. For the Playwright suite only — its desktop and mobile projects
# share a loopback IP and trip Better Auth's default rate limiter. Leave
# unset everywhere else; it must never be set on a deployment (the code also
# refuses to honour it when VERCEL is set, as a second guard).
# E2E_DISABLE_RATE_LIMIT="true"
